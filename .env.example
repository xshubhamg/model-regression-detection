# Any OpenAI-compatible provider works — swap without code changes.
# OpenRouter (primary):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash

PROMPT_VERSION=v1
LLM_TEMPERATURE=0

# Eval thresholds
PASS_THRESHOLD=0.90
MAX_DROP_VS_BASELINE=0.05
RESULTS_DB=results.db

# Slow-drift detection over live-run history (mocked runs excluded)
DRIFT_WINDOW=7
DRIFT_THRESHOLD=0.90

# Slack — paste when needed, otherwise payload is logged to slack_payload.json
SLACK_WEBHOOK_URL=
