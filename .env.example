# Provider-agnostic — swap without code changes.
# OpenRouter (primary):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# CommandCode Provider API (OpenAI-compatible). Requires Provider plan or higher —
# Go-plan keys authenticate (GET /models works) but POST /chat/completions returns
# 403 upgrade_required. Verified 2026-09-04.
# LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# LLM_MODEL=deepseek/deepseek-v4-flash

PROMPT_VERSION=v1
LLM_TEMPERATURE=0

# Eval thresholds
PASS_THRESHOLD=0.90
MAX_DROP_VS_BASELINE=0.05
RESULTS_DB=results.db

# Slack — paste when needed, otherwise payload is logged to slack_payload.json
SLACK_WEBHOOK_URL=
