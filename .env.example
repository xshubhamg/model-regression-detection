# Provider-agnostic — swap without code changes.
# OpenRouter (primary):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# CommandCode fallback (cheap open-weights), e.g.:
# LLM_BASE_URL=<commandcode-openai-compatible-url>
# LLM_MODEL=deepseek/deepseek-v4-flash

PROMPT_VERSION=v1
LLM_TEMPERATURE=0

# Eval thresholds
PASS_THRESHOLD=0.90
MAX_DROP_VS_BASELINE=0.05
RESULTS_DB=results.db

# Slack — paste when needed, otherwise payload is logged to slack_payload.json
SLACK_WEBHOOK_URL=
